{
  "manifest_version": 3,
  "name": "Chess Break — Checkmate Trainer",
  "short_name": "Chess Break",
  "version": "0.1.0",
  "description": "Five-minute chess breaks: Mate in 1-2-3 puzzles, a daily challenge, Puzzle Rush and Finish the Position vs a local bot. Offline, no account.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chess Break",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "sidePanel"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
